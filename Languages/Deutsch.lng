# Mandelbulb3D interface language (UTF-8)
#
# One text per line. Left of the "=" is where the text is used: the
# window ([section]), the control and its property, or in [Strings] the
# English text the program shows while it runs. Right of the "=" is the
# text in this language. A line left out keeps the English text.
# "\n" is a line break, "\\" a backslash, "\s" a space at the start or
# end of a text, "\=" an equals sign left of the "=". "&" before a letter
# underlines it (the Alt key shortcut); {} and {0}, {1} ... are values
# the program fills in (a translation may change their order).
#
# Your own language: click the language badge in the title bar of the
# main window, type the language's name and press "Create language
# file"; translate the new file with a text editor and press "Reload".
# The file's name is the language's; "code" is shown on the badge. A
# picture <name>.png next to the file is the language's flag (18 x 12).
language = Deutsch
code = DE

