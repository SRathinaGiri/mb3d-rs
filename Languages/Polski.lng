SupportedFunctionsEdit.Lines.62 = { Funkcje wykładnicze }
SupportedFunctionsEdit.Lines.64 = { IntPower: podnosi podstawę do potęgi całkowitej.  Szybkie. }
SupportedFunctionsEdit.Lines.65 = function IntPower(const Base: Double; const Exponent: Integer): Double;
SupportedFunctionsEdit.Lines.67 = { Power: podnosi podstawę do dowolnej potęgi.
SupportedFunctionsEdit.Lines.68 = \s\sDla wykładników ułamkowych lub |wykładnik| > MaxInt podstawa musi być > 0. }
