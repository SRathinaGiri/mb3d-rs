;, {} under way
UnfinishedCalculation=Niedokończone obliczenie
;Unfinished calculation
UnfinishedRender=Niedokończony render
;Unfinished render
UnfinishedRenders=Niedokończone rendery
;Unfinished renders
UnfinishedRendersContinueOrDeleteThem=Niedokończone rendery: kontynuuj lub usuń
