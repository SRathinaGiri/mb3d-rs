SupportedFunctionsEdit.Lines.75 = { Floor: największa liczba całkowita <= X,  |X| < MaxInt }
SupportedFunctionsEdit.Lines.76 = function Floor(const X: Double): Integer;
SupportedFunctionsEdit.Lines.78 = { MinValue: zwraca najmniejszą wartość ze znakiem w tablicy danych (MIN) }
SupportedFunctionsEdit.Lines.79 = function Min(const A, B: Double): Double;
SupportedFunctionsEdit.Lines.81 = { MaxValue: zwraca największą wartość ze znakiem w tablicy danych (MAX) }
SupportedFunctionsEdit.Lines.82 = function Max(const A, B: Double): Double;
SupportedFunctionsEdit.Lines.84 = { RandG generuje liczby losowe o rozkładzie Gaussa wokół wartości średniej.
SupportedFunctionsEdit.Lines.85 = \s\sPrzydatne do symulowania danych z błędami próbkowania. }
SupportedFunctionsEdit.Lines.86 = function RandG(Mean, StdDev: Double): Double;
