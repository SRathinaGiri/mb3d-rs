SupportedFunctionsEdit.Lines.15 = function ArcSin(const X : Double) : Double;
SupportedFunctionsEdit.Lines.17 = { ArcTan2 oblicza ArcTan(Y/X) i zwraca kąt we właściwej ćwiartce.
SupportedFunctionsEdit.Lines.18 = \s\sWE: |Y| < 2^64, |X| < 2^64, X <> 0   WY: [-PI..PI] radianów }
SupportedFunctionsEdit.Lines.19 = function ArcTan2(const Y, X: Double): Double;
SupportedFunctionsEdit.Lines.21 = { SinCos jest 2x szybsze niż osobne wywołanie Sin i Cos dla tego samego kąta }
SupportedFunctionsEdit.Lines.22 = procedure SinCos(const Theta: Double; var Sin, Cos: Double);
