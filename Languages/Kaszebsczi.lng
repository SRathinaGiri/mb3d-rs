StopTheCurrentCalculation=Zatrzëmôj biéżné rechòwanié.
;Stop the current calculation.
Stopping=Zatrzëmiwanié...
;Stopping...
StoppingThisComputerFinishesThePart=Zatrzëmiwanié: nen kòmpùtr kùńczi dzél, chtëren renderëje
;Stopping: this computer finishes the part it is rendering
StopsWalkingAtThisDistanceTo=Zatrzimùje chòdzenié w tim òddaleniu òd òbiektu.\nNastôw 0, żebë wëłączëc.
;Stops walking at this distance to the object.\nSet to 0 to disable.
StoreAnAdditionalCorrespondingPNGFile=Zapisëje dodatkòwi òdpòwiedny lopk *.PNG dlô prostszégò pòdzérkù òbrôzka
;Store an additional corresponding *.PNG-file for simpler preview of the image
StoreM3IFileInDefaultFolder=Zapiszë lopk M3I w domëslnym katalogù
;Store M3I file in default folder
StorePNGPreview=Zapiszë pòdzérk PNG
;Store PNG-preview
Strength=Mòc:
;Strength:
