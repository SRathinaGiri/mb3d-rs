SupportedFunctionsEdit.Lines.65 = function IntPower(const Base: Double; const Exponent: Integer): Double;
SupportedFunctionsEdit.Lines.67 = { Power: Pòdnôszô spòdlé do równo jaczi pòtãdżi.
SupportedFunctionsEdit.Lines.68 = \s\sDlô ùłómkòwëch wëkładników abò |wëkładnik| > MaxInt spòdlé mùszi bëc > 0. }
SupportedFunctionsEdit.Lines.69 = function Power(const Base, Exponent: Double): Double;
SupportedFunctionsEdit.Lines.71 = { Rozmajité procedurë }
SupportedFunctionsEdit.Lines.72 = { Ceil: Nômniészô całownô lëczba >= X, |X| < MaxInt }
SupportedFunctionsEdit.Lines.73 = function Ceil(const X: Double): Integer;
SupportedFunctionsEdit.Lines.75 = { Floor: Nôwikszô całownô lëczba <= X,  |X| < MaxInt }
SupportedFunctionsEdit.Lines.76 = function Floor(const X: Double): Integer;
SupportedFunctionsEdit.Lines.78 = { MinValue: Zwrôcô nômniészą wôrtnotã ze znakã w tôflë pòdôwków (MIN) }
SupportedFunctionsEdit.Lines.79 = function Min(const A, B: Double): Double;
SupportedFunctionsEdit.Lines.81 = { MaxValue: Zwrôcô nôwikszą wôrtnotã ze znakã w tôflë pòdôwków (MAX) }
SupportedFunctionsEdit.Lines.82 = function Max(const A, B: Double): Double;
SupportedFunctionsEdit.Lines.84 = { RandG dôwô przëtrôfkòwé lëczbë z rozkładã Gaussa wkół strzédny.
SupportedFunctionsEdit.Lines.85 = \s\sPrzëdatné do symùlowaniô pòdôwków z błãdama próbkòwaniô. }
SupportedFunctionsEdit.Lines.86 = function RandG(Mean, StdDev: Double): Double;
SupportedFunctionsEdit.Lines.88 = { Testowanié ekstremalnëch wôrtnotów }
SupportedFunctionsEdit.Lines.89 = // Jak nieskùńczonosc, wôrtnota NaN tipù double mô wëkładnik 7FF, ale wôrtnotë NaN
SupportedFunctionsEdit.Lines.90 = // mają pòle ùłómka, jaczé nie je 0.
SupportedFunctionsEdit.Lines.91 = function IsNan(const AValue: Double): Boolean;
SupportedFunctionsEdit.Lines.93 = // Jak NaN, wôrtnota nieskùńczonoscë tipù double mô wëkładnik 7FF, ale
SupportedFunctionsEdit.Lines.94 = // wôrtnotë nieskùńczonoscë mają pòle ùłómka równé 0. Nieskùńczonosc mòże bëc dodatnô
SupportedFunctionsEdit.Lines.95 = // abò ùjemnô, co òznôczô nôwëższi bit, bit znakù.
SupportedFunctionsEdit.Lines.96 = function IsInfinite(const AValue: Double): Boolean;

