SupportedFunctionsEdit.Lines.10 = { --------------------- Functions from System.Math  -------------------------- }
SupportedFunctionsEdit.Lines.11 = { Trigonometric functions }
SupportedFunctionsEdit.Lines.12 = { IN: |X| <= 1  OUT: [0..PI] radians }
SupportedFunctionsEdit.Lines.13 = function ArcCos(const X : Double) : Double;
SupportedFunctionsEdit.Lines.14 = { IN: |X| <= 1  OUT: [-PI/2..PI/2] radians }
SupportedFunctionsEdit.Lines.15 = function ArcSin(const X : Double) : Double;
SupportedFunctionsEdit.Lines.17 = { ArcTan2 calculates ArcTan(Y/X), and returns an angle in the correct quadrant.
SupportedFunctionsEdit.Lines.18 = \s\sIN: |Y| < 2^64, |X| < 2^64, X <> 0   OUT: [-PI..PI] radians }
SupportedFunctionsEdit.Lines.19 = function ArcTan2(const Y, X: Double): Double;
