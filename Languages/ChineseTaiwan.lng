SupportedFunctionsEdit.Lines.1 = { ----------------------- 來自 System 的函式  ----------------------------- }
SupportedFunctionsEdit.Lines.2 = function Int(const X: Double): Double;
SupportedFunctionsEdit.Lines.3 = function Frac(const X: Double): Double;
SupportedFunctionsEdit.Lines.4 = function Exp(const X: Double): Double;
SupportedFunctionsEdit.Lines.5 = function Cos(const X: Double): Double;
SupportedFunctionsEdit.Lines.6 = function Sin(const X: Double): Double;
SupportedFunctionsEdit.Lines.7 = function Ln(const X: Double): Double;
SupportedFunctionsEdit.Lines.8 = function ArcTan(const X: Double): Double;
SupportedFunctionsEdit.Lines.9 = function Sqrt(const X: Double): Double;
SupportedFunctionsEdit.Lines.10 = { --------------------- 來自 System.Math 的函式  -------------------------- }
SupportedFunctionsEdit.Lines.11 = { 三角函式 }
SupportedFunctionsEdit.Lines.12 = { 輸入：|X| <= 1  輸出：[0..PI] 弧度 }
SupportedFunctionsEdit.Lines.13 = function ArcCos(const X : Double) : Double;
SupportedFunctionsEdit.Lines.14 = { 輸入：|X| <= 1  輸出：[-PI/2..PI/2] 弧度 }
SupportedFunctionsEdit.Lines.15 = function ArcSin(const X : Double) : Double;
SupportedFunctionsEdit.Lines.17 = { ArcTan2 計算 ArcTan(Y/X)，並傳回位於正確象限的角度。
SupportedFunctionsEdit.Lines.18 = \s\s輸入：|Y| < 2^64, |X| < 2^64, X <> 0   輸出：[-PI..PI] 弧度 }
SupportedFunctionsEdit.Lines.19 = function ArcTan2(const Y, X: Double): Double;
SupportedFunctionsEdit.Lines.21 = { 對同一角度而言，SinCos 比分別呼叫 Sin 與 Cos 快 2 倍 }
SupportedFunctionsEdit.Lines.22 = procedure SinCos(const Theta: Double; var Sin, Cos: Double);
SupportedFunctionsEdit.Lines.23 = function Tan(const X: Double): Double;
SupportedFunctionsEdit.Lines.24 = function Cotan(const X: Double): Double;
SupportedFunctionsEdit.Lines.25 = function Secant(const X: Double): Double;
SupportedFunctionsEdit.Lines.26 = function Cosecant(const X: Double): Double;
SupportedFunctionsEdit.Lines.27 = function Hypot(const X, Y: Double): Double;
SupportedFunctionsEdit.Lines.29 = { 角度單位轉換函式 }
SupportedFunctionsEdit.Lines.30 = function RadToDeg(const Radians: Double): Double;
SupportedFunctionsEdit.Lines.31 = function DegToRad(const Degrees: Double): Double;
SupportedFunctionsEdit.Lines.33 = { 當角度不在 -180 到 180 之間時，去除超出的部分 }
SupportedFunctionsEdit.Lines.34 = function DegNormalize(const Degrees: Double): Double;
SupportedFunctionsEdit.Lines.36 = { 雙曲函式及其反函式 }
SupportedFunctionsEdit.Lines.37 = function Cot(const X: Double): Double;
SupportedFunctionsEdit.Lines.38 = function Sec(const X: Double): Double;
SupportedFunctionsEdit.Lines.39 = function Csc(const X: Double): Double;
SupportedFunctionsEdit.Lines.40 = function Cosh(const X: Double): Double;
SupportedFunctionsEdit.Lines.41 = function Sinh(const X: Double): Double;
SupportedFunctionsEdit.Lines.42 = function Tanh(const X: Double): Double;
SupportedFunctionsEdit.Lines.43 = function CotH(const X: Double): Double;
SupportedFunctionsEdit.Lines.44 = function SecH(const X: Double): Double;
SupportedFunctionsEdit.Lines.45 = function CscH(const X: Double): Double;
SupportedFunctionsEdit.Lines.46 = function ArcCot(const X: Double): Double;
SupportedFunctionsEdit.Lines.47 = function ArcSec(const X: Double): Double;
SupportedFunctionsEdit.Lines.48 = function ArcCsc(const X: Double): Double;
SupportedFunctionsEdit.Lines.49 = function ArcCosh(const X: Double): Double;
SupportedFunctionsEdit.Lines.50 = function ArcSinh(const X: Double): Double;
SupportedFunctionsEdit.Lines.51 = function ArcTanh(const X: Double): Double;
SupportedFunctionsEdit.Lines.52 = function ArcCotH(const X: Double): Double;
SupportedFunctionsEdit.Lines.53 = function ArcSecH(const X: Double): Double;
SupportedFunctionsEdit.Lines.54 = function ArcCscH(const X: Double): Double;
SupportedFunctionsEdit.Lines.56 = { 對數函式 }
SupportedFunctionsEdit.Lines.57 = function LnXP1(const X: Double): Double;
SupportedFunctionsEdit.Lines.58 = function Log10(const X: Double): Double;
SupportedFunctionsEdit.Lines.59 = function Log2(const X: Double): Double;
SupportedFunctionsEdit.Lines.60 = function LogN(const Base, X: Double): Double;
SupportedFunctionsEdit.Lines.62 = { 指數函式 }
SupportedFunctionsEdit.Lines.64 = { IntPower：將底數提升至整數次方。速度快。 }
SupportedFunctionsEdit.Lines.65 = function IntPower(const Base: Double; const Exponent: Integer): Double;
SupportedFunctionsEdit.Lines.67 = { Power：將底數提升至任意次方。
SupportedFunctionsEdit.Lines.68 = \s\s若指數為分數，或 |指數| > MaxInt，底數必須 > 0。 }
SupportedFunctionsEdit.Lines.69 = function Power(const Base, Exponent: Double): Double;
SupportedFunctionsEdit.Lines.71 = { 其他函式 }
SupportedFunctionsEdit.Lines.72 = { Ceil：>= X 的最小整數，|X| < MaxInt }
SupportedFunctionsEdit.Lines.73 = function Ceil(const X: Double): Integer;
SupportedFunctionsEdit.Lines.75 = { Floor：<= X 的最大整數，  |X| < MaxInt }
SupportedFunctionsEdit.Lines.76 = function Floor(const X: Double): Integer;
SupportedFunctionsEdit.Lines.78 = { MinValue：傳回資料陣列中最小的帶符號值 (MIN) }
SupportedFunctionsEdit.Lines.79 = function Min(const A, B: Double): Double;
SupportedFunctionsEdit.Lines.81 = { MaxValue：傳回資料陣列中最大的帶符號值 (MAX) }
SupportedFunctionsEdit.Lines.82 = function Max(const A, B: Double): Double;
SupportedFunctionsEdit.Lines.84 = { RandG 產生以平均值為中心、呈高斯分布的隨機數。
SupportedFunctionsEdit.Lines.85 = \s\s適用於模擬含取樣誤差的資料。 }
SupportedFunctionsEdit.Lines.86 = function RandG(Mean, StdDev: Double): Double;
SupportedFunctionsEdit.Lines.88 = { 極值檢測 }
SupportedFunctionsEdit.Lines.89 = // 與無限大一樣，NaN 的 double 值其指數為 7FF，但 NaN
SupportedFunctionsEdit.Lines.90 = // 值的小數部分欄位不為 0。
SupportedFunctionsEdit.Lines.91 = function IsNan(const AValue: Double): Boolean;
SupportedFunctionsEdit.Lines.93 = // 與 NaN 一樣，無限大的 double 值其指數為 7FF，但
SupportedFunctionsEdit.Lines.94 = // 無限大值的小數部分欄位為 0。無限大值可為正
SupportedFunctionsEdit.Lines.95 = // 或負，由最高位的符號位元決定。
SupportedFunctionsEdit.Lines.96 = function IsInfinite(const AValue: Double): Boolean;

