# Mandelbulb3D interface language (UTF-8)
#
# One text per line. Left of the "=" is where the text is used: the
# window ([section]), the control and its property, or in [Strings] the
# English text the program shows while it runs. Right of the "=" is the
# text in this language. A line left out keeps the English text.
# "\n" is a line break, "\\" a backslash, "\s" a space at the start or
# end of a text, "\=" an equals sign left of the "=". "&" before a letter
# underlines it (the Alt key shortcut); {} and {0}, {1} ... are values
# the program fills in (a translation may change their order).
#
# Your own language: click the language badge in the title bar of the
# main window, type the language's name and press "Create language
# file"; translate the new file with a text editor and press "Reload".
# The file's name is the language's; "code" is shown on the badge.

language = 日本語
code = JA
font = Japanese.ttf

[Mand3DForm]
PositionBtn.Caption = 位置
PositionBtn.Hint = クリックで表示/非表示を切り替えます
RotationBtn.Caption = 回転
RotationBtn.Hint = クリックで表示/非表示を切り替えます
Label9.Caption = X 中心:
Label10.Caption = Y 中心:
SpeedButton32.Caption = Z 中心
SpeedButton32.Hint = クリックすると中心点の 2D 平面を描画します。
SpeedButton33.Caption = Z 開始
SpeedButton33.Hint = クリックすると 2D 開始平面を描画します。
SpeedButton34.Caption = Z 終了
SpeedButton34.Hint = クリックすると Z 終了平面を描画します。
SpeedButton30.Caption = 中心点を取得
SpeedButton30.Hint = 画像内で中心にしたいオブジェクトをクリックします。\nカメラの向きは変わりません。中心点の周りを回転させるには\n回転オプションを使用してください。
SpeedButton31.Caption = リセット
SpeedButton31.Hint = 位置と回転を初期値にリセットします。\nボックス系の式では自動的にさらにズームアウトされます。
Label5.Caption = ズーム:
Edit5.Hint = Z 開始ビュー平面のサイズを定義します。\nナビゲーターを使用すると自動的に設定されます。\nオブジェクトが画像の端で切れている場合のみ\n変更してください。
Label53.Caption = オイラー角:
Label57.Caption = 変更した値は「画像に適用」で反映してください。編集欄は出力のみです
Button7.Caption = 画像に適用
Button7.Hint = 回転は中心点 (X 中心、Y 中心、Z 中心) の周りで行われます
ButtonR0.Caption = 0 にリセット
Edit31.Hint = Y 角が 90 または -90 度の場合、オイラー角は計算できません!
Memo1.Hint = メッセージを表示します
TabSheet2.Caption = 計算
Label16.Caption = スムーズ法線:
Label18.Caption = DE stop:
Label22.Caption = レイステップ倍率:
Label13.Caption = 二分探索の\nステップ数:
SpeedButton10.Hint = 「M」をクリックすると、これらの設定と画像の幅・スケールを\nプリセットとして保存します。その後「プレビュー」「中」「高」を\nクリックするか、もう一度「M」をクリックしてキャンセルします。
Label26.Caption = ステップ幅制限:
Edit25.Hint = レイマーチングを停止するオブジェクト表面までの距離を定義します。\n小さい値ほどオブジェクトの細部が出ますが、アンダーサンプリングの原因にもなります。\n値はピクセル幅を基準にしています。
CheckBox9.Caption = FOV で DEstop を変化:
CheckBox9.Hint = レイマーチングを停止するオブジェクト表面までの距離が、視点からの距離に応じて大きくなります。\nオブジェクトの見え方が均一になるため、通常はオンにします。
CheckBox1.Caption = DE 上の法線:
CheckBox1.Hint = 画像が平坦でノイズが多く見える場合はオフにしてください。
Edit6.Hint = 距離推定値にこの係数を掛けて縮小し、オーバーステップを防ぎます。\nオーバーステップ (黒いピクセル、ノイズの多い画像) が発生する場合は値を下げてください。\n値が小さすぎるとレンダリングが遅くなります。
CheckBox3.Caption = 最初のステップをランダム化:
CheckBox3.Hint = 最初のステップ幅に乱数を掛けて、\nオーバーステップのアーティファクトをノイズ状にします。  \nダイナミックフォグのバンディングも軽減します。\s
CheckBox8.Caption = 近距離 DE チェック:
CheckBox8.Hint = 急峻なハイトマップに有効です
Edit8.Hint = 1 より小さい値でオーバーステップを軽減します。
CheckBox2.Caption = レイステップから DEstop を減算:
CheckBox2.Hint = 次のレイステップから DEstop の一部を差し引きます。DEstop の値が大きい場合に推奨します。
