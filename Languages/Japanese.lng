SupportedFunctionsEdit.Lines.14 = { 入力: |X| <= 1  出力: [-PI/2..PI/2] ラジアン }
SupportedFunctionsEdit.Lines.15 = function ArcSin(const X : Double) : Double;
SupportedFunctionsEdit.Lines.17 = { ArcTan2 は ArcTan(Y/X) を計算し、正しい象限の角度を返します。
SupportedFunctionsEdit.Lines.18 = \s\s入力: |Y| < 2^64, |X| < 2^64, X <> 0   出力: [-PI..PI] ラジアン }
SupportedFunctionsEdit.Lines.19 = function ArcTan2(const Y, X: Double): Double;
